# 公开商店构建保持本机运行；只有配置有效 HTTPS 地址时才启用云端账号。
VITE_PUBLIC_STORE=false
VITE_PAYMENTS_ENABLED=true
VITE_API_BASE_URL=
VITE_CONTENT_API_BASE_URL=

# 设备授权默认关闭；Windows 仅在启动前显式设置 MORAN_DEVICE_AUTH=enabled 时校验。
MORAN_DEVICE_AUTH=disabled

# 私有服务端配置。必须使用独立强密码和至少 32 字符的随机密钥。
MORAN_PORT=3000
MORAN_DB_PATH=./server/moran.db
MORAN_ADMIN_USER=
MORAN_ADMIN_PASSWORD=
MORAN_TOKEN_SECRET=
MORAN_ALLOWED_ORIGINS=http://127.0.0.1:65084,http://localhost:65084,null
MORAN_TRUST_PROXY=false
MORAN_PUBLIC_HOST=moranenglish.cn

# 套餐、订单与实时同步。正式环境推荐 epay：二维码是渠道固定金额订单，不是个人收款码。
MORAN_PUBLIC_BASE_URL=
MORAN_PAYMENT_PROVIDER=none
MORAN_PAYMENT_GATEWAY=
MORAN_PAYMENT_PID=
MORAN_PAYMENT_KEY=
MORAN_PAYMENT_CHANNEL=alipay
MORAN_PAYMENT_NOTIFY_URL=
MORAN_PAYMENT_RETURN_URL=
MORAN_ONLINE_TIMEOUT_MS=600000

# 找回密码短信。当前未接入服务商时保持 disabled。
# dev 仅允许本机测试；生产可使用腾讯云短信或 webhook 中转。
MORAN_SMS_MODE=disabled
MORAN_SMS_WEBHOOK_URL=
MORAN_SMS_WEBHOOK_TOKEN=
MORAN_TENCENT_SECRET_ID=
MORAN_TENCENT_SECRET_KEY=
MORAN_TENCENT_SMS_APP_ID=
MORAN_TENCENT_SMS_SIGN=
MORAN_TENCENT_SMS_TEMPLATE_ID=
MORAN_TENCENT_SMS_REGION=ap-guangzhou
