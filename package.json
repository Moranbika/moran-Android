{
  "name": "miaoda-react-standard-webapp-app",
  "version": "0.2.9",
  "description": "莫兰英语词汇学习应用",
  "author": "莫兰应用开发者",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --config vite.mobile.config.ts --mode web",
    "build:webpay": "vite build --config vite.mobile.config.ts --mode webpay",
    "build:web:portable": "npm run build:web && node scripts/build-web-portable.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:mobile:device-auth": "vite build --config vite.mobile.config.ts --mode device-auth",
    "build:harmony": "npm run build:mobile && node scripts/prepare-harmony.mjs",
    "build:harmony:device-auth": "npm run build:mobile:device-auth && node scripts/prepare-harmony.mjs",
    "build:store:mobile": "vite build --config vite.mobile.config.ts --mode store",
    "build:store:harmony": "npm run build:store:mobile && node scripts/prepare-harmony.mjs",
    "build:test:mobile": "vite build --config vite.mobile.config.ts --mode test",
    "build:test:harmony": "npm run build:test:mobile && node scripts/prepare-harmony.mjs",
    "ios:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-ios.ps1",
    "ios:install:ipad": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-ios.ps1 -TargetKind iPad",
    "ios:close": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/close-ios-app.ps1",
    "ios:admin:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-admin-ios-ipa.ps1",
    "ios:admin:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-ios.ps1 -IpaPath release/platforms/ios/MoranAdmin-unsigned.ipa -TargetKind iPad",
    "electron:build": "vite build --config vite.electron.config.ts",
    "electron:dist": "electron-builder --win nsis",
    "content:export": "node scripts/export-content.mjs",
    "server:start": "node --env-file-if-exists=.env --experimental-sqlite server/server.js",
    "server:smoke": "node scripts/server-smoke.mjs",
    "admin:e2e": "electron scripts/e2e-admin.cjs",
    "typecheck": "tsc -p tsconfig.app.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.18",
    "@tailwindcss/typography": "^0.5.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compromise": "^14.19.0",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.7.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.13.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.2.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9",
    "electron": "^44.9.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.moranbika.cet6",
    "productName": "莫兰",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "electron/**",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "莫兰-Setup-${version}.exe"
    }
  }
}
